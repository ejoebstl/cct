#!/usr/bin/env bash
# cct - claude code tmux launcher (one session per agent)
#
# Usage:
#   cct new <name> [base]        Create new worktree on new branch off base (default: development)
#   cct check <branch>           Worktree on existing branch (local or remote)
#   cct resume <name>            Open existing worktree, resume last claude session
#   cct rm <name>                Remove worktree (keeps branch) and kill its tmux session
#   cct ls                       List worktrees and tmux sessions for this repo
#
# Flags:
#   -k, --backup-key             Pass $BACKUP_ANTHROPIC_KEY to claude as ANTHROPIC_API_KEY.
#                                For new sessions, set via tmux -e. For existing sessions,
#                                tmux set-environment is used (running claude won't pick it up
#                                until restarted).
#
# Each agent gets its own tmux session named <repo>-<name>, so detaching from
# one or killing one doesn't affect the others. New claude sessions are
# auto-renamed via /rename so they show up readably in --resume pickers.
#
# New worktrees automatically symlink .envrc, python_env/, and virtual_env/
# from the main repo if they exist, so direnv and the shared venv work
# without copying.

set -euo pipefail

# ---------- helpers ----------
die() { printf 'cct: %s\n' "$*" >&2; exit 1; }

require_repo() {
  git rev-parse --show-toplevel >/dev/null 2>&1 || die "not in a git repo"
}

paths_for() {
  # Sets: repo_root, repo_name, parent, wt_path, session
  repo_root=$(git rev-parse --show-toplevel)
  repo_name=$(basename "$repo_root")
  parent=$(dirname "$repo_root")
  wt_path="$parent/$repo_name-$1"
  session="$repo_name-$1"
}

link_shared() {
  # Symlink .envrc and python_env/ from the main repo into $wt_path,
  # if they exist in the main repo and aren't already present in the worktree.
  local item link target
  for item in .envrc python_env virtual_env; do
    target="$repo_root/$item"
    link="$wt_path/$item"
    [[ ! -e "$target" ]] && continue
    if [[ -L "$link" ]]; then
      echo "  · $item already linked"
      continue
    fi
    if [[ -e "$link" ]]; then
      echo "  · $item exists in worktree (not a symlink) — leaving it alone"
      continue
    fi
    ln -s "$target" "$link"
    echo "  · linked $item → $target"
  done

  if [[ -L "$wt_path/.envrc" ]] && command -v direnv >/dev/null 2>&1; then
    # direnv status: "Found RC allowed N" where 0=Allowed, 1=NotAllowed, 2=Denied.
    if ( cd "$wt_path" && direnv status 2>/dev/null ) | grep -qE 'Found RC allowed 0$'; then
      echo "  · .envrc already allowed"
    else
      if ( cd "$wt_path" && direnv allow ) >/dev/null 2>&1; then
        echo "  · direnv allowed"
      else
        echo "  · direnv allow failed (run manually if needed)" >&2
      fi
    fi
  fi
}

start_or_attach_session() {
  # $1 = window name, $2 = cwd, $3 = command
  local win="$1" cwd="$2" cmd="$3"

  if ! tmux has-session -t "$session" 2>/dev/null; then
    # Source .envrc into claude's env via direnv exec. tmux -c sets cwd, so '.' resolves there.
    if [[ -e "$cwd/.envrc" ]] && command -v direnv >/dev/null 2>&1; then
      cmd="direnv exec . $cmd"
    fi

    if [[ "$use_backup_key" == "1" ]]; then
      tmux new-session -d -s "$session" -c "$cwd" \
        -e "ANTHROPIC_API_KEY=$BACKUP_ANTHROPIC_KEY" -n "$win" "$cmd"
    else
      tmux new-session -d -s "$session" -c "$cwd" -n "$win" "$cmd"
    fi
  elif [[ "$use_backup_key" == "1" ]]; then
    tmux set-environment -t "$session" ANTHROPIC_API_KEY "$BACKUP_ANTHROPIC_KEY"
    echo "  · ANTHROPIC_API_KEY set for $session (restart claude in the pane to pick it up)"
  fi

  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$session"
  else
    tmux attach -t "$session"
  fi
}

# ---------- commands ----------
cmd_new() {
  local name="${1:?usage: cct new <name> [base]}"
  local base="${2:-development}"
  paths_for "$name"

  [[ -d "$wt_path" ]] && die "worktree already exists: $wt_path  (try 'cct resume $name')"

  local branch="feat/$name"
  echo "→ Creating worktree $wt_path on new branch $branch (base: $base)"
  git -C "$repo_root" worktree add "$wt_path" -b "$branch" "$base"
  link_shared

  start_or_attach_session "$name" "$wt_path" "claude '/rename $name'"
}

cmd_check() {
  local branch="${1:?usage: cct check <branch>}"
  local name="${branch//\//-}"
  paths_for "$name"

  if [[ -d "$wt_path" ]]; then
    link_shared
    start_or_attach_session "$name" "$wt_path" "claude --resume"
    return
  fi

  git -C "$repo_root" fetch --quiet
  echo "→ Creating worktree $wt_path on existing branch $branch"
  git -C "$repo_root" worktree add "$wt_path" "$branch"
  link_shared

  start_or_attach_session "$name" "$wt_path" "claude '/rename $name'"
}

cmd_resume() {
  local name="${1:?usage: cct resume <name>}"
  paths_for "$name"
  [[ -d "$wt_path" ]] || die "no worktree at $wt_path"
  link_shared
  start_or_attach_session "$name" "$wt_path" "claude --resume"
}

cmd_rm() {
  local name="${1:?usage: cct rm <name>}"
  paths_for "$name"
  [[ -d "$wt_path" ]] || die "no worktree at $wt_path"

  # Kill the tmux session if present
  if tmux has-session -t "$session" 2>/dev/null; then
    tmux kill-session -t "$session"
  fi

  # git worktree remove will rm -rf the directory, including symlinks.
  # The symlink targets (.envrc, python_env, virtual_env in the main repo) are NOT touched.
  git -C "$repo_root" worktree remove "$wt_path"
  echo "→ Removed $wt_path  (branch preserved; delete with 'git branch -d feat/$name')"
}

cmd_ls() {
  require_repo
  local repo_name
  repo_name=$(basename "$(git rev-parse --show-toplevel)")

  echo "Worktrees:"
  git worktree list
  echo

  local sessions
  sessions=$(tmux list-sessions -F '#S' 2>/dev/null | grep "^${repo_name}-" || true)
  if [[ -n "$sessions" ]]; then
    echo "Tmux sessions for this repo:"
    while IFS= read -r s; do
      local attached
      attached=$(tmux display-message -p -t "$s" '#{?session_attached,(attached),}')
      echo "  $s $attached"
    done <<< "$sessions"
  else
    echo "No tmux sessions running for this repo."
  fi
}

# ---------- dispatch ----------
require_repo

# Optional: pass $BACKUP_ANTHROPIC_KEY to claude as ANTHROPIC_API_KEY.
# Strip the flag from the args wherever it appears so subcommands stay clean.
use_backup_key=0
filtered=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -k|--backup-key) use_backup_key=1 ;;
    *) filtered+=("$1") ;;
  esac
  shift
done
if [[ "$use_backup_key" == "1" ]]; then
  [[ -n "${BACKUP_ANTHROPIC_KEY:-}" ]] || die "-k/--backup-key set but BACKUP_ANTHROPIC_KEY env var is empty"
fi
set -- "${filtered[@]+"${filtered[@]}"}"

case "${1:-}" in
  new)    shift; cmd_new    "$@" ;;
  check)  shift; cmd_check  "$@" ;;
  resume) shift; cmd_resume "$@" ;;
  rm)     shift; cmd_rm     "$@" ;;
  ls)     cmd_ls ;;
  ""|-h|--help)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) die "unknown command: $1  (try: cct --help)" ;;
esac